{
  "name": "trolly-agent",
  "productName": "Trolly Agent",
  "version": "0.1.0",
  "description": "Trolly Agent - a desktop AI companion with MCP tools, ComfyUI artistry, and local LLM providers",
  "author": "Joshua Coleman",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/copy-assets.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:assets && npm run build:electron && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && vue-tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/",
    "test:avatar": "npm run build && node scripts/smoke-avatar.mjs",
    "verify:safe-mode": "node scripts/verify-safe-mode.mjs",
    "verify:clean-generation": "node scripts/verify-clean-generation.mjs",
    "verify:after-dark-race": "node scripts/verify-after-dark-clean-race.mjs",
    "verify:after-dark-visible": "node scripts/verify-after-dark-visible.mjs",
    "build:assets": "python scripts/make-icons.py",
    "start": "npm run build && electron .",
    "autostart:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:remove": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-autostart.ps1",
    "verify:leak": "node scripts/verify-no-leak.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "kokoro-js": "^1.2.1",
    "pinia": "^3.0.3",
    "three": "^0.187.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^38.2.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.5",
    "vue-tsc": "^2.2.10"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.28.2": true
  }
}
